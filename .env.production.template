# MongoDB Atlas
# 1. Crea cuenta en https://www.mongodb.com/cloud/atlas
# 2. Crea un cluster (M0 Free tier disponible)
# 3. Database Access: crea usuario con contraseña
# 4. Network Access: añade 0.0.0.0/0 o IPs específicas de Vercel
# 5. Connect → Connect your application → copia connection string
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# NextAuth (PRODUCCIÓN)
# IMPORTANTE: Cambia esto a tu dominio de producción
NEXTAUTH_URL=https://yourdomain.com
# Genera un nuevo secret SOLO para producción: openssl rand -base64 32
NEXTAUTH_SECRET=generate-a-secure-random-secret-different-from-local

# Auth Providers
# Mismos que en local, o diferentes según necesites en producción
AUTH_PROVIDERS=email,google,facebook

# Google OAuth (PRODUCCIÓN)
# Añade en Google Cloud Console → Authorized redirect URIs:
# https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id-production
GOOGLE_CLIENT_SECRET=your-google-client-secret-production

# Facebook OAuth (PRODUCCIÓN)
# Añade en Facebook App → Settings → Valid OAuth Redirect URIs:
# https://yourdomain.com/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=your-facebook-app-id-production
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret-production

# Email (PRODUCCIÓN)
# Usa un servicio de email transaccional en producción:
# - SendGrid (https://sendgrid.com)
# - Mailgun (https://www.mailgun.com)
# - Amazon SES (https://aws.amazon.com/ses)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key

# Theme Colors
# Mismos colores o diferentes para producción
PRIMARY_COLOR=#3b82f6
SECONDARY_COLOR=#10b981
BACKGROUND_COLOR=#ffffff
TEXT_COLOR=#1f2937
