{
  "name": "[YOUR_APP]",
  "version": "1.0.0",
  "private": true,
  "org": "[YOUR_ORG]",
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=200",
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "expo-constants": "18.0.12",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "scripts": {
    "dev": "yarn workspace @[YOUR_ORG]/web dev",
    "build": "yarn build:packages && yarn build:web",
    "build:packages": "yarn workspace @[YOUR_ORG]/types build && yarn workspace @[YOUR_ORG]/database build && yarn workspace @[YOUR_ORG]/api build && yarn workspace @[YOUR_ORG]/auth build && yarn workspace @[YOUR_ORG]/ui build && yarn workspace @[YOUR_ORG]/configs build && yarn workspace @[YOUR_ORG]/utils build",
    "build:web": "yarn workspace @[YOUR_ORG]/web build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next",
    "prepare": "husky",
    "clean-db": "ts-node --project scripts/tsconfig.json scripts/database/clean-database.ts",
    "clean-db:force": "ts-node --project scripts/tsconfig.json scripts/database/clean-database.ts --force",
    "clean-db:stats": "ts-node --project scripts/tsconfig.json scripts/database/clean-database.ts --stats",
    "sync-odoo-users": "ts-node --project scripts/tsconfig.json scripts/database/sync-odoo-users.ts",
    "dev:all": "./scripts/dev-all.sh",
    "sync-assets": "node scripts/sync-assets.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^25.0.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fast-check": "^3.23.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "dependencies": {
    "@[YOUR_ORG]/api": "^1.0.1"
  }
}
