# MongoDB
MONGODB_URI=mongodb://localhost:27017/auth-system

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here-change-in-production-generate-with-openssl-rand-base64-32

# Auth Providers (comma separated: email,google,facebook)
# Solo incluye los que necesites. 'email' siempre debe estar incluido para login con contraseña
AUTH_PROVIDERS=email,google

# Google OAuth (get from https://console.cloud.google.com)
# 1. Crea un proyecto en Google Cloud Console
# 2. Habilita Google+ API
# 3. Credentials → Create OAuth 2.0 Client ID
# 4. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (get from https://developers.facebook.com)
# 1. Crea una app en Facebook Developers
# 2. Añade producto "Facebook Login"
# 3. Settings → Basic: copia App ID y App Secret
# 4. Facebook Login → Settings → Valid OAuth Redirect URIs: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email (for password recovery)
# Para Gmail:
# 1. Ve a tu cuenta Google → Security → 2-Step Verification
# 2. App passwords → Genera una contraseña para "Mail"
# 3. Usa esa contraseña aquí (no tu contraseña normal de Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Theme Colors (hexadecimal format)
# Personaliza los colores de tu aplicación
PRIMARY_COLOR=#3b82f6
SECONDARY_COLOR=#10b981
BACKGROUND_COLOR=#ffffff
TEXT_COLOR=#1f2937
