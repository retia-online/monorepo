{
    "name": "@megamercado-vzla/ui",
    "version": "1.0.1",
    "description": "UI components and layouts for MegaMercado applications",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/**/*",
        "src/**/*"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "@megamercado-vzla:registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "jest",
