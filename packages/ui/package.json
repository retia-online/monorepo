{
  "name": "@retia-global/ui",
  "version": "1.0.1",
  "description": "UI components and layouts for MegaMercado applications",
  "main": "./src/index.tsx",
  "module": "./src/index.tsx",
  "types": "./src/index.tsx",
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "@retia-global:registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "clean": "rm -rf dist"
  },
  "dependencies": {},
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/addon-links": "^10.1.6",
    "@storybook/blocks": "^8.6.14",
    "@storybook/react": "^10.1.6",
    "@storybook/react-vite": "^10.1.6",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/jest": "^29.5.8",
    "@types/react": "^18.2.45",
    "@vitejs/plugin-react": "^5.1.2",
    "fast-check": "^3.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "storybook": "^10.1.6",
    "ts-jest": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3",
    "vite": "^7.2.7"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "react-native-web": ">=0.19.0"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "megamercado",
    "typescript"
  ],
  "author": "MegaMercado Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/megamercado-vzla/ui.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.tsx",
      "import": "./src/index.tsx",
      "require": "./src/index.tsx",
      "default": "./src/index.tsx"
    }
  }
