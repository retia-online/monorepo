{
  "name": "@megamercado/configs",
  "version": "1.0.0",
  "description": "Shared configuration presets for MegaMercado applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "tailwind.preset.js",
    "tsconfig.base.json",
    "tsconfig.react.json",
    "eslint.config.js"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "@megamercado:registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/megamercado/configs.git"
  },
  "keywords": [
    "config",
    "preset",
    "tailwind",
    "typescript",
    "eslint",
    "megamercado"
  ],
  "author": "MegaMercado",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "peerDependencies": {
    "tailwindcss": "^3.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0 || ^9.0.0"
  }
}