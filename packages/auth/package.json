{
  "name": "@retia-global/auth",
  "version": "1.0.1",
  "description": "Authentication SDK with NextAuth configuration and route protection middleware",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/megamercado-vzla/auth.git"
  },
  "keywords": [
    "auth",
    "nextauth",
    "authentication",
    "middleware",
    "route-protection"
  ],
  "author": "Megamercado Organization",
  "license": "MIT",
  "dependencies": {
    "next-auth": "5.0.0-beta.25",
    "@retia-global/api": "file:../api",
    "zod": "^3.22.4",
    "jose": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/jest": "^29.5.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "fast-check": "^3.15.0",
    "typescript": "^5.3.3",
    "tsup": "^8.0.1",
    "next": "^16.0.0"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0"
  },
  "module": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
