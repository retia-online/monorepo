{
  "name": "@retia-app/monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"yarn workspace @retia-app/web dev\" \"yarn workspace @retia-app/mobile start\"",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "clean": "yarn workspaces run clean",
    "clean:all": "rm -rf node_modules && find . -name \"node_modules\" -type d -exec rm -rf {} +",
    "setup": "./scripts/environments/local/setup.sh",
    "cleanup": "./scripts/environments/common/cleanup.sh"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "packageManager": "yarn@1.22.22+",
  "engines": {
    "node": ">=18.0.0"
  }
}