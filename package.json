{
  "name": "monorepo",
  "version": "1.0.0",
  "private": true,
  "org": "core-monorepo",
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix --max-warnings=200",
      "prettier --write"
    ],
    "**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "resolutions": {
    "expo-constants": "18.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "dev": "yarn workspace @app/web dev",
    "build": "yarn build:packages && yarn build:web",
    "build:packages": "yarn workspace @core/types build && yarn workspace @core/database build && yarn workspace @core/api build && yarn workspace @core/auth build && yarn workspace @core/ui build && yarn workspace @core/configs build && yarn workspace @core/utils build",
    "build:web": "yarn workspace @app/web build",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "clean": "rm -rf node_modules apps/*/node_modules apps/*/.next",
    "prepare": "husky",
    "clean-db": "ts-node --project scripts/tsconfig.json scripts/database/clean-database.ts",
    "clean-db:force": "ts-node --project scripts/tsconfig.json scripts/database/clean-database.ts --force",
    "clean-db:stats": "ts-node --project scripts/tsconfig.json scripts/database/clean-database.ts --stats",
    "sync-odoo-users": "ts-node --project scripts/tsconfig.json scripts/database/sync-odoo-users.ts",
    "dev:all": "./scripts/dev-all.sh",
    "sync-assets": "node scripts/sync-assets.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^29.5.8",
    "@types/node": "^25.0.0",
    "@typescript-eslint/eslint-plugin": "^8.49.0",
    "@typescript-eslint/parser": "^8.49.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "fast-check": "^3.23.2",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "dependencies": {
    "@core/api": "^1.0.1"
  }
}
