# ============================================
# MONOREPO - SHARED ENVIRONMENT VARIABLES
# ============================================
# Variables compartidas entre todas las aplicaciones del monorepo
# Copia este archivo como .env.local y configura los valores

# ============================================
# Instance Configuration
# ============================================
# Name of the application instance
INSTANCE=monorepo

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# MongoDB connection string
# For local development: mongodb://127.0.0.1:27017/retia-db
# For production: mongodb+srv://user:pass@cluster.mongodb.net/retia-db
MONGODB_URI=mongodb://127.0.0.1:27017/retia-db

# ============================================
# NextAuth Configuration (REQUIRED)
# ============================================
# Base URL for the web application
# For development: http://localhost:3000
# For production: https://your-domain.com
NEXTAUTH_URL=http://localhost:3000

# NextAuth secret key (REQUIRED)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# ============================================
# Authentication Providers (REQUIRED)
# ============================================
# Comma separated list of enabled auth providers
# Options: email, google, facebook
# Example: "email,google,facebook" or just "email"
AUTH_PROVIDERS=email

# ============================================
# OAuth Configuration (OPTIONAL)
# ============================================
# Google OAuth - Get from: https://console.cloud.google.com
# 1. Create project → Enable Google+ API
# 2. Credentials → OAuth 2.0 Client ID
# 3. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth - Get from: https://developers.facebook.com
# 1. Create app → Add Facebook Login product
# 2. Settings → Basic: copy App ID and App Secret
# 3. Valid OAuth Redirect URIs: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ============================================
# Email Configuration (OPTIONAL)
# ============================================
# SMTP settings for password recovery emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
