# ============================================
# MOBILE APP - ENVIRONMENT VARIABLES
# ============================================
# Client-side variables for Expo React Native application
# Copy this file as .env.local and configure the values
# 
# IMPORTANT: This is a MOBILE APP (client-side)
# - Uses EXPO_PUBLIC_ prefix for public variables
# - Does NOT connect directly to database
# - All data operations go through backend API
#
# Architecture: Mobile App → Backend API → Database

# ============================================
# Backend API Configuration (REQUIRED)
# ============================================
# URL of the backend API server (Next.js web app)
# For development: http://localhost:9001
# For production: https://your-domain.com
# For physical device: http://YOUR_LOCAL_IP:9001 (e.g., http://192.168.1.100:9001)
EXPO_PUBLIC_API_URL=http://localhost:9001

# ============================================
# Authentication Configuration (REQUIRED)
# ============================================
# Authentication mode - controls app behavior
# - "required": Login required - shows login screen first
# - "disabled": No login - goes directly to main screen, no auth options
# - "optional": Optional login - main screen first, auth available in profile
EXPO_PUBLIC_AUTH_MODE=optional

# Available login methods (comma separated)
# Options: email, phone, facebook, google
# MUST match web app AUTH_PROVIDERS configuration
# Example: "email,google,facebook" or just "email"
EXPO_PUBLIC_AUTH_METHODS=email

# ============================================
# OAuth Configuration (OPTIONAL)
# ============================================
# Google OAuth - Get from: https://console.cloud.google.com
# IMPORTANT: Must match web app GOOGLE_CLIENT_ID
# Only Client ID needed for mobile (public)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Facebook OAuth - Get from: https://developers.facebook.com
# IMPORTANT: Must match web app FACEBOOK_CLIENT_ID
# Only App ID needed for mobile (public)
EXPO_PUBLIC_FACEBOOK_APP_ID=your-facebook-app-id

# ============================================
# App Configuration (OPTIONAL)
# ============================================
# Application instance name (e.g., monorepo, production, staging)
EXPO_PUBLIC_INSTANCE=monorepo

# Main screen message (shown when logged in or auth disabled)
EXPO_PUBLIC_MAIN_SCREEN_MESSAGE=Hola Mundo

# Theme colors (hex format)
EXPO_PUBLIC_PRIMARY_COLOR=#6366f1
EXPO_PUBLIC_SECONDARY_COLOR=#ec4899
EXPO_PUBLIC_BACKGROUND_COLOR=#f8fafc
EXPO_PUBLIC_TEXT_COLOR=#1e293b

# Font family (e.g., Manrope, Inter, Roboto)
EXPO_PUBLIC_FONT_FAMILY=Manrope

# ============================================
# Development Configuration
# ============================================
NODE_ENV=development
