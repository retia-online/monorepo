# ============================================
# MOBILE APP - STAGING ENVIRONMENT VARIABLES
# ============================================
# Configuración para builds de staging de la app móvil
# Estas variables se usan al construir la app para staging

INSTANCE=Retia-Staging

# ============================================
# Backend API Configuration (REQUIRED)
# ============================================
# URL de la API en Vercel staging
# Vercel asigna: https://[app-name]-[hash].vercel.app
EXPO_PUBLIC_API_URL=https://retia-app-staging.vercel.app

# ============================================
# Authentication Configuration (REQUIRED)
# ============================================
EXPO_PUBLIC_AUTH_MODE=required

# Métodos de autenticación para staging
# Debe coincidir con AUTH_PROVIDERS en web app
EXPO_PUBLIC_AUTH_METHODS=email,google

# ============================================
# OAuth Configuration (OPTIONAL)
# ============================================
# Google OAuth - Client ID para staging
# Debe coincidir con GOOGLE_CLIENT_ID en web app
EXPO_PUBLIC_GOOGLE_CLIENT_ID=[GOOGLE_CLIENT_ID_STAGING]

# Facebook OAuth - App ID para staging
EXPO_PUBLIC_FACEBOOK_APP_ID=[FACEBOOK_APP_ID_STAGING]

# Odoo Configuration
EXPO_PUBLIC_ODOO_URL=https://labs.retia.vzla.online/

# ============================================
# App Configuration (OPTIONAL)
# ============================================
EXPO_PUBLIC_INSTANCE=Retia-Staging
EXPO_PUBLIC_MAIN_SCREEN_MESSAGE=¡Bienvenido a Retia Staging!

# ============================================
# Design Configuration
# ============================================
# Debe coincidir con web app theme
EXPO_PUBLIC_PRIMARY_COLOR=6366f1
EXPO_PUBLIC_SECONDARY_COLOR=ec4899
EXPO_PUBLIC_BACKGROUND_COLOR=f8fafc
EXPO_PUBLIC_TEXT_COLOR=1e293b
EXPO_PUBLIC_FONT_FAMILY=Manrope

# ============================================
# Internacionalización (i18n)
# ============================================
EXPO_PUBLIC_DEFAULT_LOCALE=es
EXPO_PUBLIC_LOCALES=es,en,pt

# ============================================
# Analytics & Tracking Pixels (OPCIONAL para staging)
# ============================================
# Meta (Facebook & Instagram)
EXPO_PUBLIC_META_PIXEL_ID=

# TikTok
EXPO_PUBLIC_TIKTOK_PIXEL_ID=

# LinkedIn
EXPO_PUBLIC_LINKEDIN_INSIGHT_TAG=

# X (Twitter)
EXPO_PUBLIC_X_PIXEL_ID=

# Pinterest
EXPO_PUBLIC_PINTEREST_TAG_ID=

# Google Tag Manager
EXPO_PUBLIC_GTM_ID=

# ============================================
# Notas importantes
# ============================================
# 1. Estas variables se compilan en el build de la app
# 2. Para staging, crear un build específico con estas variables
# 3. Usar credenciales separadas de producción
# 4. EXPO_PUBLIC_API_URL debe coincidir con NEXTAUTH_URL de web app
# 5. Para testing en dispositivos físicos, usar URL pública accesible
# 6. Considerar usar environment-specific builds con EAS