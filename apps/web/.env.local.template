# ============================================
# WEB APP - LOCAL ENVIRONMENT TEMPLATE
# ============================================
# Copia este archivo como .env.local y ajusta los valores
# Uso: cp .env.local.template .env.local
#
# .env.local NO se commitea (está en .gitignore)
# Este template SÍ se commitea como referencia
# ============================================

INSTANCE=Retia-Local
NEXT_PUBLIC_INSTANCE=Retia-Local

# ============================================
# Database — MongoDB local
# ============================================
# Requiere MongoDB corriendo localmente
# Iniciar con: brew services start mongodb-community
MONGODB_URI=mongodb://localhost:27017/retia-local

# ============================================
# NextAuth
# ============================================
NEXTAUTH_URL=http://localhost:9001
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=your-local-nextauth-secret-here

# ============================================
# Authentication
# ============================================
# required | disabled | optional
AUTH_MODE=required
# email | google | facebook | odoo  (comma separated)
AUTH_PROVIDERS=email

# ============================================
# OAuth (opcional)
# ============================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# ============================================
# Odoo (opcional)
# ============================================
# ODOO_URL=https://odoo.your-domain.com/
# ODOO_DB=your-odoo-db
# ODOO_ADMIN_UID=2
# ODOO_ADMIN_PASSWORD=
# ODOO_WEBHOOK_SECRET=

# ============================================
# Email (opcional)
# ============================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=your-email@gmail.com

# ============================================
# Environment
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# Theme
# ============================================
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_LOCALES=es,en,pt
NEXT_PUBLIC_PRIMARY_COLOR=3b82f6
NEXT_PUBLIC_SECONDARY_COLOR=10b981
NEXT_PUBLIC_BACKGROUND_COLOR=ffffff
NEXT_PUBLIC_TEXT_COLOR=1f2937
NEXT_PUBLIC_FONT_FAMILY=Manrope
