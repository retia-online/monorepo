# ============================================
# WEB APP - DEVELOP/STAGING ENVIRONMENT TEMPLATE
# ============================================
# Copia este archivo como .env.develop y ajusta los valores
# Uso: cp .env.develop.template .env.develop
#
# .env.develop NO se commitea (está en .gitignore)
# Este template SÍ se commitea como referencia
# ============================================

INSTANCE=Retia Develop
NEXT_PUBLIC_INSTANCE=retia-develop

# ============================================
# Vercel Configuration
# ============================================
VERCEL_EMAIL=info@retia.online
VERCEL_USERNAME=retia-online

# ============================================
# GitHub Configuration
# GITHUB_TOKEN: Personal Access Token de la cuenta retia-online
#   Crear en: https://github.com/settings/tokens → Tokens (classic)
#   Permisos requeridos: repo (full control)
# ============================================
GITHUB_USERNAME=retia-online
GITHUB_EMAIL=info@retia.online
GITHUB_TOKEN=your-github-token-here

# ============================================
# MongoDB Atlas API
# Obtener en: Atlas → Organization → Access Manager → API Keys
#   Permisos requeridos: Project Owner
# ATLAS_PROJECT_ID: Atlas → Project Settings → Project ID
# ============================================
ATLAS_PUBLIC_KEY=your-atlas-public-key
ATLAS_PRIVATE_KEY=your-atlas-private-key
ATLAS_PROJECT_ID=your-atlas-project-id

# ============================================
# Database — MongoDB Atlas (develop)
# Usuario: solo debe tener readWrite en app_develop (sin acceso a app_production)
# Configurar con: ./scripts/environments/common/setup-mongodb.sh
# ============================================
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/app_develop?appName=app

# ============================================
# NextAuth
# ============================================
NEXTAUTH_URL=https://develop-monorepo.vercel.app/
# Generar con: openssl rand -base64 32  (DIFERENTE al de production)
NEXTAUTH_SECRET=your-develop-nextauth-secret-here

# ============================================
# Authentication
# ============================================
AUTH_MODE=required
AUTH_PROVIDERS=email

# ============================================
# Environment
# ============================================
NODE_ENV=production
LOG_LEVEL=debug

# ============================================
# Theme
# ============================================
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_LOCALES=es,en,pt
NEXT_PUBLIC_PRIMARY_COLOR=3b82f6
NEXT_PUBLIC_SECONDARY_COLOR=10b981
NEXT_PUBLIC_BACKGROUND_COLOR=ffffff
NEXT_PUBLIC_TEXT_COLOR=1f2937
NEXT_PUBLIC_FONT_FAMILY=Manrope
