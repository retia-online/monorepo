# ==============================================
# Environment Configuration Template
# ==============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit .env.local to version control

# ----------------------------------------------
# Node Environment
# ----------------------------------------------
NODE_ENV=development

# ----------------------------------------------
# Database
# ----------------------------------------------
# MongoDB connection string
# Format: mongodb://username:password@host:port/database
# or: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017/retia

# ----------------------------------------------
# NextAuth Configuration
# ----------------------------------------------
# URL where your app is hosted (include protocol and port in development)
NEXTAUTH_URL=http://localhost:3000

# Secret for signing JWT tokens (generate with: openssl rand -base64 32)
# MUST be at least 32 characters
NEXTAUTH_SECRET=your-super-secret-key-min-32-characters-long-please-change-this

# ----------------------------------------------
# Authentication Providers
# ----------------------------------------------
# Comma-separated list of enabled providers
# Options: email, google, facebook
AUTH_PROVIDERS=email

# Google OAuth (optional - only needed if google is in AUTH_PROVIDERS)
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (optional - only needed if facebook is in AUTH_PROVIDERS)
# Get credentials from: https://developers.facebook.com/apps/
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# ----------------------------------------------
# Email/SMTP Configuration (Optional)
# ----------------------------------------------
# Required for sending emails (password reset, welcome emails, etc.)
# If you configure one SMTP field, you must configure all of them

# SMTP server hostname
SMTP_HOST=smtp.gmail.com

# SMTP server port (usually 587 for TLS, 465 for SSL)
SMTP_PORT=587

# SMTP username (usually your email address)
SMTP_USER=your-email@gmail.com

# SMTP password or app-specific password
SMTP_PASSWORD=your-app-password

# Email address to send from
SMTP_FROM=noreply@yourdomain.com

# ----------------------------------------------
# Logging Configuration (Optional)
# ----------------------------------------------
# Log level: trace, debug, info, warn, error, fatal
# Default: debug in development, info in production
LOG_LEVEL=debug

# ==============================================
# Production Environment Variables
# ==============================================
# For production, create a .env.production file with:
# - NODE_ENV=production
# - Secure NEXTAUTH_SECRET (different from development)
# - Production MONGODB_URI
# - Production NEXTAUTH_URL (your actual domain)
# - LOG_LEVEL=info or warn
# ==============================================
