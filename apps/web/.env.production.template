# ============================================
# WEB APP - PRODUCTION ENVIRONMENT TEMPLATE
# ============================================
# Copia este archivo como .env.production y ajusta los valores
# Uso: cp .env.production.template .env.production
#
# .env.production NO se commitea (está en .gitignore)
# Este template SÍ se commitea como referencia
# ============================================

INSTANCE=Retia
NEXT_PUBLIC_INSTANCE=retia

# ============================================
# Vercel Configuration
# ============================================
VERCEL_EMAIL=info@retia.online
VERCEL_USERNAME=retia-online

# ============================================
# GitHub Configuration
# GITHUB_TOKEN: Personal Access Token de la cuenta retia-online
#   Crear en: https://github.com/settings/tokens → Tokens (classic)
#   Permisos requeridos: repo (full control)
# ============================================
GITHUB_USERNAME=retia-online
GITHUB_EMAIL=info@retia.online
GITHUB_TOKEN=your-github-token-here

# ============================================
# MongoDB Atlas API
# Mismas claves que en .env.develop (mismo proyecto Atlas)
# ============================================
ATLAS_PUBLIC_KEY=your-atlas-public-key
ATLAS_PRIVATE_KEY=your-atlas-private-key
ATLAS_PROJECT_ID=your-atlas-project-id

# ============================================
# Database — MongoDB Atlas (production)
# Usuario: atlasAdmin (acceso total al cluster)
# Configurar con: ./scripts/environments/common/setup-mongodb.sh
# ⚠️  Usar un cluster M10+ en producción real (no M0 free)
# ============================================
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/app_production?appName=app

# ============================================
# NextAuth
# ============================================
NEXTAUTH_URL=https://retia.online/
# Generar con: openssl rand -base64 32  (DIFERENTE al de develop)
NEXTAUTH_SECRET=your-production-nextauth-secret-here

# ============================================
# Authentication
# ============================================
AUTH_MODE=required
AUTH_PROVIDERS=email

# ============================================
# Environment
# ============================================
NODE_ENV=production
LOG_LEVEL=error

# ============================================
# Theme
# ============================================
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_LOCALES=es,en,pt
NEXT_PUBLIC_PRIMARY_COLOR=3b82f6
NEXT_PUBLIC_SECONDARY_COLOR=10b981
NEXT_PUBLIC_BACKGROUND_COLOR=ffffff
NEXT_PUBLIC_TEXT_COLOR=1f2937
NEXT_PUBLIC_FONT_FAMILY=Manrope
