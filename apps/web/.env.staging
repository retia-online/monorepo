# ============================================
# WEB APP - STAGING ENVIRONMENT VARIABLES
# ============================================
# Configuración para staging/preview en Vercel
# Este archivo es para referencia, las variables reales se configuran en Vercel Dashboard

INSTANCE=Retia-Staging
NEXT_PUBLIC_INSTANCE=Retia-Staging

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# MongoDB Atlas - Cluster de staging
# Reemplazar con tu connection string real de MongoDB Atlas
MONGODB_URI=mongodb+srv://staging-user:[PASSWORD]@staging-cluster.xxxxx.mongodb.net/retia-staging?retryWrites=true&w=majority

# ============================================
# NextAuth Configuration (REQUIRED)
# ============================================
# URL de la aplicación en Vercel (se actualiza automáticamente)
# Vercel asigna: https://[app-name]-[hash].vercel.app
NEXTAUTH_URL=https://retia-app-staging.vercel.app

# NextAuth secret key (REQUIRED)
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=[GENERAR_NUEVA_CLAVE_SEGURA_32_CARACTERES]

# ============================================
# Authentication Mode & Providers (REQUIRED)
# ============================================
AUTH_MODE=required

# Métodos de autenticación para staging
# email, odoo, google, facebook
AUTH_PROVIDERS=email,google

# ============================================
# OAuth Configuration (OPTIONAL - pero recomendado para testing)
# ============================================
# Google OAuth - Credenciales de staging
# Crear en: https://console.cloud.google.com
# Configurar Authorized redirect URIs: https://retia-app-staging.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=[GOOGLE_CLIENT_ID_STAGING]
GOOGLE_CLIENT_SECRET=[GOOGLE_CLIENT_SECRET_STAGING]

# Facebook OAuth - Credenciales de staging
FACEBOOK_CLIENT_ID=[FACEBOOK_APP_ID_STAGING]
FACEBOOK_CLIENT_SECRET=[FACEBOOK_APP_SECRET_STAGING]

# ============================================
# Odoo Configuration (OPCIONAL - si se usa en staging)
# ============================================
ODOO_URL=https://labs.retia.vzla.online/
ODOO_DB=labs
ODOO_ADMIN_UID=2
ODOO_ADMIN_PASSWORD=3_antropoides

# ============================================
# Email Configuration (RECOMENDADO para testing)
# ============================================
# Resend API Key para staging
RESEND_API_KEY=[RESEND_API_KEY_STAGING]
RESEND_FROM_EMAIL=onboarding@resend.dev

# SMTP settings para fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=[EMAIL_STAGING@gmail.com]
SMTP_PASSWORD=[APP_PASSWORD]
SMTP_FROM=noreply@retia-staging.com

# ============================================
# Environment Configuration
# ============================================
NODE_ENV=production
LOG_LEVEL=debug

# ============================================
# Internacionalización (i18n)
# ============================================
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_LOCALES=es,en
NEXT_PUBLIC_PRIMARY_COLOR=6366f1
NEXT_PUBLIC_SECONDARY_COLOR=ec4899
NEXT_PUBLIC_BACKGROUND_COLOR=f8fafc
NEXT_PUBLIC_TEXT_COLOR=1e293b
NEXT_PUBLIC_FONT_FAMILY=Manrope

# ============================================
# Analytics & Tracking Pixels (OPCIONAL para staging)
# ============================================
# Meta (Facebook & Instagram)
NEXT_PUBLIC_META_PIXEL_ID=

# TikTok
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# LinkedIn
NEXT_PUBLIC_LINKEDIN_INSIGHT_TAG=

# X (Twitter)
NEXT_PUBLIC_X_PIXEL_ID=

# Pinterest
NEXT_PUBLIC_PINTEREST_TAG_ID=

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=

# ============================================
# Vercel Specific Configuration
# ============================================
# Vercel automáticamente inyecta:
# - VERCEL_ENV=preview
# - VERCEL_URL=[deployment-url]
# - VERCEL_GIT_COMMIT_SHA=[commit-sha]
# - VERCEL_GIT_COMMIT_MESSAGE=[commit-message]

# ============================================
# Notas importantes
# ============================================
# 1. Este archivo es para referencia local
# 2. Las variables reales deben configurarse en Vercel Dashboard
# 3. Para preview deployments, Vercel usa automáticamente .env.production
# 4. Generar NEXTAUTH_SECRET único para staging
# 5. Usar credenciales separadas de producción
# 6. El primer usuario registrado obtiene rol ADMIN automáticamente