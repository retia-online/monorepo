# ============================================
# WEB APP - ENVIRONMENT VARIABLES
# ============================================
# Backend/Server-side variables for Next.js web application
# Copy this file as .env.local and configure the values
# DO NOT commit .env.local to version control

# ============================================
# Database Configuration (REQUIRED)
# ============================================
# MongoDB connection string - SAME as monorepo root
# For local development: mongodb://127.0.0.1:27017/monorepo
# For production: mongodb+srv://user:pass@cluster.mongodb.net/monorepo
MONGODB_URI=mongodb://127.0.0.1:27017/monorepo

# ============================================
# NextAuth Configuration (REQUIRED)
# ============================================
# Base URL for the web application - SAME as monorepo root
# For development: http://localhost:9001
# For production: https://your-domain.com
NEXTAUTH_URL=http://localhost:9001

# NextAuth secret key (REQUIRED) - SAME as monorepo root
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-key-here

# ============================================
# Authentication Providers (REQUIRED)
# ============================================
# Comma separated list of enabled auth providers - SAME as monorepo root
# Options: email, google, facebook
# Example: "email,google,facebook" or just "email"
# MUST match mobile app EXPO_PUBLIC_AUTH_METHODS
AUTH_PROVIDERS=email

# ============================================
# OAuth Configuration (OPTIONAL)
# ============================================
# Google OAuth - Get from: https://console.cloud.google.com
# IMPORTANT: GOOGLE_CLIENT_ID must match mobile EXPO_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth - Get from: https://developers.facebook.com
# IMPORTANT: FACEBOOK_CLIENT_ID must match mobile EXPO_PUBLIC_FACEBOOK_APP_ID
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# ============================================
# Email Configuration (OPTIONAL)
# ============================================
# SMTP settings for password recovery emails - SAME as monorepo root
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

# ============================================
# Development Configuration
# ============================================
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# Design Configuration (OPTIONAL)
# ============================================
# Colores del tema (formato hex)
NEXT_PUBLIC_PRIMARY_COLOR=#6366f1
NEXT_PUBLIC_SECONDARY_COLOR=#ec4899
NEXT_PUBLIC_BACKGROUND_COLOR=#f8fafc
NEXT_PUBLIC_TEXT_COLOR=#1e293b

# Fuente del tema (Google Fonts)
NEXT_PUBLIC_FONT_FAMILY=Manrope
